# Copy to .env and fill in. .env is git-ignored.
VALLOX_HOST=192.168.x.y
FREEATHOME_BASE_URL=http://192.168.x.z
FREEATHOME_API_USERNAME=installer
FREEATHOME_API_PASSWORD=
