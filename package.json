{
  "name": "freeathome-vallox",
  "version": "0.1.3",
  "description": "free@home add-on for Vallox MyVallox ventilation units (local websocket API)",
  "main": "build/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "tsc -p .",
    "start": "node build/main.js",
    "probe": "tsc -p . && node build/tools/probe.js",
    "test": "tsc -p tsconfig.test.json && node --test build-test/test/",
    "validate": "fah validate",
    "pack": "npm run build && fah buildscriptarchive build",
    "dev": "tsc -p . && node --env-file=.env build/main.js"
  },
  "dependencies": {
    "@busch-jaeger/free-at-home": "0.37.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@busch-jaeger/free-at-home-cli": "0.13.1",
    "@types/node": "^20.12.7",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.3"
  },
  "author": "J. Gilles",
  "repository": {
    "type": "git",
    "url": "https://github.com/juliangilles/free-home-vallox.git"
  }
}
